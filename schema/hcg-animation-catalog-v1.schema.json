{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "com.hakmicapitalgroup.animation-catalog/1",
  "title": "HCG animation catalog, format version 1",
  "description": "A list of animation packs served over HTTPS. Each item names the folder its files are hosted in (baseURL: absolute https URL or a path relative to the catalog; empty = not hosted yet) and every file's size and SHA-256. Clients verify each file and the pack before caching it, and keep the last catalog that loaded when a refresh fails.",
  "type": "object",
  "required": ["format", "formatVersion", "items"],
  "properties": {
    "format": { "const": "com.hakmicapitalgroup.animation-catalog" },
    "formatVersion": { "const": 1 },
    "title": { "type": "string" },
    "updated": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "baseURL", "files"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$", "description": "The pack's id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "summary": { "type": "string" },
          "packFormatVersion": { "type": "integer", "minimum": 1 },
          "baseURL": { "type": "string", "pattern": "^$|/$", "description": "FILL IN: https URL of the folder holding the files, ending with /" },
          "poster": { "type": "string", "description": "One of the item's files, shown in the catalog" },
          "media": {
            "type": "object",
            "properties": { "width": { "type": "number" }, "height": { "type": "number" }, "duration": { "type": "number" } }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["file", "bytes", "sha256"],
              "properties": {
                "file": { "type": "string", "pattern": "^[^./\\\\:][^/\\\\:]*$" },
                "bytes": { "type": "integer", "minimum": 0 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "role": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
